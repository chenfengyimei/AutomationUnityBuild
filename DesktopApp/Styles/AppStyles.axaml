<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock.FieldLabel">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,8,0,2" />
  </Style>

  <Style Selector=":is(Button).primary">
    <Setter Property="Background" Value="#2563EB" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector=":is(Button).danger">
    <Setter Property="Background" Value="#DC2626" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector=":is(Button).secondary">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="#1E293B" />
    <Setter Property="Width" Value="200" />
  </Style>

  <Style Selector=":is(Button).nav">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector=":is(Button).nav.active">
    <Setter Property="Background" Value="#334155" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector=":is(Button).nav:pointerover">
    <Setter Property="Background" Value="#334155" />
  </Style>

  <Style Selector="Border.content-area">
    <Setter Property="Padding" Value="24,20" />
  </Style>

  <Style Selector=":is(TextBox).log-output">
    <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Background" Value="#0F172A" />
    <Setter Property="Foreground" Value="#E2E8F0" />
    <Setter Property="BorderBrush" Value="#334155" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="White" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="#E2E8F0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="20,16" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style Selector="Border.metric">
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="#E2E8F0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>

  <Style Selector="TextBlock.metric-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#64748B" />
  </Style>

  <Style Selector="TextBlock.metric-value">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TextBlock.page-subtitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#64748B" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style Selector="Border.status-badge">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <Style Selector="Border.status-badge.succeeded">
    <Setter Property="Background" Value="#DCFCE7" />
  </Style>

  <Style Selector="Border.status-badge.failed">
    <Setter Property="Background" Value="#FEE2E2" />
  </Style>

  <Style Selector="Border.status-badge.running">
    <Setter Property="Background" Value="#DBEAFE" />
  </Style>

  <Style Selector="Border.status-badge.queued">
    <Setter Property="Background" Value="#FEF3C7" />
  </Style>

  <Style Selector="Border.status-badge.canceled">
    <Setter Property="Background" Value="#F1F5F9" />
  </Style>

</Styles>
