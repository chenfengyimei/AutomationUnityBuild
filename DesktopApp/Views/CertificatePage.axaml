<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesktopApp.Views.CertificatePage">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" Spacing="12">
      <TextBlock Classes="page-title" Text="证书管理" />
      <TextBlock Classes="page-subtitle" Text="管理可复用的签名证书与密钥模板，新建打包配置时可一键填充" />

      <!-- Toolbar -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Content="刷新列表" Click="Refresh_Click" IsVisible="{Binding !IsEditing}" />
        <Button Classes="secondary" Content="➕ 新建证书模板" Click="Create_Click" IsVisible="{Binding !IsEditing}" />
        <Button Classes="secondary" Content="✏️ 编辑" Click="Edit_Click" IsVisible="{Binding !IsEditing}" />
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" />

      <!-- List -->
      <Border Classes="card" IsVisible="{Binding !IsEditing}">
        <StackPanel Spacing="8">
          <TextBlock Text="证书模板列表" FontWeight="Bold" Margin="0,0,0,8" />
          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="120">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Platform}" FontSize="11" Foreground="#2563EB" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Classes="danger" Content="🗑 删除选中" Click="Delete_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Edit Form -->
      <Border Classes="card" IsVisible="{Binding IsEditing}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding IsNew, StringFormat='{}新建证书模板'}" FontWeight="Bold" FontSize="16"
                     IsVisible="{Binding IsNew}" />
          <TextBlock Text="编辑证书模板" FontWeight="Bold" FontSize="16"
                     IsVisible="{Binding !IsNew}" />

          <Grid ColumnDefinitions="*,*" Margin="0">
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Classes="FieldLabel" Text="模板名称" />
              <TextBox Text="{Binding EditProfile.Name}" Watermark="例如：正式环境签名证书" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Classes="FieldLabel" Text="备注（可选）" />
              <ComboBox SelectedItem="{Binding EditProfile.Platform}">
                <ComboBoxItem Content="ios" />
                <ComboBoxItem Content="android" />
                <ComboBoxItem Content="tiktok" />
                <ComboBoxItem Content="all" />
              </ComboBox>
            </StackPanel>
          </Grid>

          <TextBlock Text="以下所有平台的字段均可填写，按需填入即可，留空的不影响其他平台" FontSize="12" Foreground="#64748B" Margin="0,4,0,4" />

          <!-- iOS fields -->
          <StackPanel Spacing="6">
            <TextBlock Text="iOS 签名配置" FontWeight="Bold" Foreground="#2563EB" />
            <Grid ColumnDefinitions="*,*,*" Margin="0">
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Classes="FieldLabel" Text="Apple Team ID" />
                <TextBox Text="{Binding EditProfile.TeamId}" Watermark="ABCDE12345" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,8,0">
                <TextBlock Classes="FieldLabel" Text="Export Method" />
                <ComboBox SelectedItem="{Binding EditProfile.ExportMethod}">
                  <ComboBoxItem Content="development" />
                  <ComboBoxItem Content="ad-hoc" />
                  <ComboBoxItem Content="app-store" />
                  <ComboBoxItem Content="enterprise" />
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="8,0,0,0">
                <TextBlock Classes="FieldLabel" Text="Deployment Target" />
                <TextBox Text="{Binding EditProfile.IosDeploymentTarget}" Watermark="13.0" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*,*" Margin="0">
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Classes="FieldLabel" Text="ASC API Key 路径" />
                <TextBox Text="{Binding EditProfile.AppStoreConnectApiKeyPath}" Watermark=".p8 路径" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,8,0">
                <TextBlock Classes="FieldLabel" Text="API Key ID" />
                <TextBox Text="{Binding EditProfile.AppStoreConnectApiKeyId}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="8,0,0,0">
                <TextBlock Classes="FieldLabel" Text="Issuer ID" />
                <TextBox Text="{Binding EditProfile.AppStoreConnectApiIssuerId}" />
              </StackPanel>
            </Grid>
            <CheckBox Content="上传 App Store Connect / TestFlight" IsChecked="{Binding EditProfile.AppStoreConnectUploadEnabled}" />
          </StackPanel>

          <!-- Android fields -->
          <StackPanel Spacing="6">
            <TextBlock Text="Android 签名配置" FontWeight="Bold" Foreground="#16A34A" />
            <Grid ColumnDefinitions="*,*" Margin="0">
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Classes="FieldLabel" Text="Keystore 路径" />
                <TextBox Text="{Binding EditProfile.AndroidKeystoreName}" Watermark="keystore 路径" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Classes="FieldLabel" Text="Key Alias" />
                <TextBox Text="{Binding EditProfile.AndroidKeyaliasName}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" Margin="0">
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Classes="FieldLabel" Text="Keystore 密码" />
                <TextBox Text="{Binding EditProfile.AndroidKeystorePass}" PasswordChar="*" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Classes="FieldLabel" Text="Key Alias 密码" />
                <TextBox Text="{Binding EditProfile.AndroidKeyaliasPass}" PasswordChar="*" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" Margin="0">
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Classes="FieldLabel" Text="Google Play Package" />
                <TextBox Text="{Binding EditProfile.GooglePlayPackageName}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Classes="FieldLabel" Text="Service Account JSON" />
                <TextBox Text="{Binding EditProfile.GooglePlayServiceAccountJsonPath}" />
              </StackPanel>
            </Grid>
            <CheckBox Content="上传 Google Play" IsChecked="{Binding EditProfile.GooglePlayUploadEnabled}" />
          </StackPanel>

          <!-- TikTok fields -->
          <StackPanel Spacing="6">
            <TextBlock Text="TikTok 小游戏配置" FontWeight="Bold" Foreground="#000000" />
            <Grid ColumnDefinitions="*,*" Margin="0">
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Classes="FieldLabel" Text="TikTok App ID" />
                <TextBox Text="{Binding EditProfile.TiktokAppId}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Classes="FieldLabel" Text="游戏名称" />
                <TextBox Text="{Binding EditProfile.TiktokGameName}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" Margin="0">
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Classes="FieldLabel" Text="Access Token" />
                <TextBox Text="{Binding EditProfile.TiktokAccessToken}" PasswordChar="*" Watermark="开放平台 Access Token" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Classes="FieldLabel" Text="API 端点" />
                <TextBox Text="{Binding EditProfile.TiktokApiEndpoint}" Watermark="https://open-api.tiktokglobalshop.com" />
              </StackPanel>
            </Grid>
            <CheckBox Content="上传 TikTok 小游戏" IsChecked="{Binding EditProfile.TiktokUploadEnabled}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Classes="primary" Content="💾 保存" Click="Save_Click" />
            <Button Classes="secondary" Content="取消" Click="Cancel_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
