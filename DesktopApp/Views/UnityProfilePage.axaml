<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesktopApp.Views.UnityProfilePage">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" Spacing="12">
      <TextBlock Classes="page-title" Text="工程管理" />
      <TextBlock Classes="page-subtitle" Text="管理 Unity 工程模板：版本、路径、Build Method、Product Name、Bundle ID" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Content="刷新列表" Click="Refresh_Click" IsVisible="{Binding !IsEditing}" />
        <Button Classes="secondary" Content="➕ 新建工程模板" Click="Create_Click" IsVisible="{Binding !IsEditing}" />
        <Button Classes="secondary" Content="✏️ 编辑" Click="Edit_Click" IsVisible="{Binding !IsEditing}" />
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" />

      <Border Classes="card" IsVisible="{Binding !IsEditing}">
        <StackPanel Spacing="8">
          <TextBlock Text="工程模板列表" FontWeight="Bold" Margin="0,0,0,8" />
          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="120">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4">
                  <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                  <TextBlock Text="{Binding UnityVersion}" FontSize="11" Foreground="#64748B" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Classes="danger" Content="🗑 删除选中" Click="Delete_Click" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsEditing}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding IsNew, StringFormat='{}新建工程模板'}" FontWeight="Bold" FontSize="16" IsVisible="{Binding IsNew}" />
          <TextBlock Text="编辑工程模板" FontWeight="Bold" FontSize="16" IsVisible="{Binding !IsNew}" />

          <StackPanel>
            <TextBlock Classes="FieldLabel" Text="模板名称" />
            <TextBox Text="{Binding EditProfile.Name}" Watermark="例如：Unity 2022 主力工程" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" Margin="0">
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Classes="FieldLabel" Text="Unity 工程相对路径" />
              <TextBox Text="{Binding EditProfile.UnityProjectRelativePath}" Watermark="." />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Classes="FieldLabel" Text="Unity 版本" />
              <TextBox Text="{Binding EditProfile.UnityVersion}" Watermark="2022.3.62f2c1" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*" Margin="0">
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Classes="FieldLabel" Text="Unity 完整路径" />
              <TextBox Text="{Binding EditProfile.UnityExecutablePath}" Watermark="留空使用 Hub 默认" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Classes="FieldLabel" Text="Unity Build Method" />
              <TextBox Text="{Binding EditProfile.UnityBuildMethod}" Watermark="留空自动推导" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*" Margin="0">
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Classes="FieldLabel" Text="Product Name" />
              <TextBox Text="{Binding EditProfile.ProductName}" Watermark="游戏名称" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Classes="FieldLabel" Text="Bundle Identifier" />
              <TextBox Text="{Binding EditProfile.BundleIdentifier}" Watermark="com.company.game" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Classes="primary" Content="💾 保存" Click="Save_Click" />
            <Button Classes="secondary" Content="取消" Click="Cancel_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
