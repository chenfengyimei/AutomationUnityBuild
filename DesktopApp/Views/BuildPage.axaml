<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesktopApp.Views.BuildPage">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Margin="24,20,24,0" Spacing="8">
      <TextBlock Classes="page-title" Text="打包任务" />
      <TextBlock Classes="page-subtitle" Text="选择配置文件，设置选项后开始打包" />

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <TextBlock Text="配置:" VerticalAlignment="Center" FontWeight="Medium" />
        <ComboBox ItemsSource="{Binding Configs}" SelectedItem="{Binding SelectedConfig}" MinWidth="300">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayText}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="secondary" Content="刷新" Click="Refresh_Click" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
        <CheckBox Content="演练模式 (dry-run)" IsChecked="{Binding DryRun}" />
        <CheckBox Content="跳过 Git" IsChecked="{Binding SkipGit}" />
        <CheckBox Content="跳过 Unity" IsChecked="{Binding SkipUnity}" />
        <CheckBox Content="跳过 Xcode" IsChecked="{Binding SkipXcode}" />
        <CheckBox Content="允许非 Mac" IsChecked="{Binding AllowNonMac}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Classes="primary" Content="▶ 开始打包" Click="StartBuild_Click" IsEnabled="{Binding !IsRunning}" />
        <Button Classes="danger" Content="■ 取消" Click="CancelBuild_Click" IsEnabled="{Binding IsRunning}" />
        <Button Classes="secondary" Content="📂 打开产物目录" Click="OpenArtifacts_Click" IsEnabled="{Binding CanOpenArtifacts}" />
        <Button Classes="secondary" Content="🗑 清空日志" Click="ClearLog_Click" IsEnabled="{Binding !IsRunning}" />
        <TextBlock Text="{Binding ElapsedText}" VerticalAlignment="Center" FontWeight="Medium" Foreground="#2563EB"
                   IsVisible="{Binding IsRunning}" Margin="8,0,0,0" />
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}" FontWeight="Medium" Margin="0,8,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Margin="24,8,24,8" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Background="#0F172A">
      <TextBox Classes="log-output" Text="{Binding LogText}" Margin="2" Name="logTextBox" />
    </Border>

    <Border Grid.Row="2" Margin="24,0,24,16" Padding="0,0,0,0">
      <TextBlock Text="日志实时显示打包进度" FontSize="11" Foreground="#94A3B8" />
    </Border>
  </Grid>
</UserControl>
