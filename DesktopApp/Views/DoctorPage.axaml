<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesktopApp.Views.DoctorPage">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Margin="24,20,24,0" Spacing="8">
      <TextBlock Classes="page-title" Text="环境检查" />
      <TextBlock Classes="page-subtitle" Text="检查 Git、Unity、Xcode 等环境是否就绪" />

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <TextBlock Text="配置:" VerticalAlignment="Center" FontWeight="Medium" />
        <ComboBox ItemsSource="{Binding Configs}" SelectedItem="{Binding SelectedConfig}" MinWidth="300">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayText}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="secondary" Content="刷新" Click="Refresh_Click" />
        <Button Classes="primary" Content="🔍 检查环境" Click="RunDoctor_Click" IsEnabled="{Binding !IsRunning}" />
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}" FontWeight="Medium" Margin="0,8,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Margin="24,8,24,16" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Background="#0F172A">
      <TextBox Classes="log-output" Text="{Binding LogText}" Margin="2" />
    </Border>
  </Grid>
</UserControl>