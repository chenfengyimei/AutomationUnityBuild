<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesktopApp.Views.SigningProfilePage">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" Spacing="12">
      <TextBlock Classes="page-title" Text="签名管理" />
      <TextBlock Classes="page-subtitle" Text="管理签名配置：iOS Team ID、导出方式、Android Keystore 等" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Content="刷新列表" Click="Refresh_Click" IsVisible="{Binding !IsEditing}" />
        <Button Classes="secondary" Content="➕ 新建签名模板" Click="Create_Click" IsVisible="{Binding !IsEditing}" />
        <Button Classes="secondary" Content="✏️ 编辑" Click="Edit_Click" IsVisible="{Binding !IsEditing}" />
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" />

      <Border Classes="card" IsVisible="{Binding !IsEditing}">
        <StackPanel Spacing="8">
          <TextBlock Text="签名模板列表" FontWeight="Bold" Margin="0,0,0,8" />
          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="120">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Platform}" FontSize="11" Foreground="#2563EB" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Classes="danger" Content="🗑 删除选中" Click="Delete_Click" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsEditing}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding IsNew, StringFormat='{}新建签名模板'}" FontWeight="Bold" FontSize="16" IsVisible="{Binding IsNew}" />
          <TextBlock Text="编辑签名模板" FontWeight="Bold" FontSize="16" IsVisible="{Binding !IsNew}" />

          <Grid ColumnDefinitions="*,*" Margin="0">
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Classes="FieldLabel" Text="模板名称" />
              <TextBox Text="{Binding EditProfile.Name}" Watermark="例如：iOS 开发签名" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Classes="FieldLabel" Text="适用平台" />
              <ComboBox SelectedItem="{Binding EditProfile.Platform}">
                <x:String>ios</x:String>
                <x:String>android</x:String>
                <x:String>all</x:String>
              </ComboBox>
            </StackPanel>
          </Grid>

          <StackPanel Spacing="6" IsVisible="{Binding IsEditIos}">
            <TextBlock Text="iOS 签名" FontWeight="Bold" Foreground="#2563EB" />
            <Grid ColumnDefinitions="*,*,*" Margin="0">
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Classes="FieldLabel" Text="Apple Team ID" />
                <TextBox Text="{Binding EditProfile.TeamId}" Watermark="ABCDE12345" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,8,0">
                <TextBlock Classes="FieldLabel" Text="Export Method" />
                <ComboBox SelectedItem="{Binding EditProfile.ExportMethod}">
                  <x:String>development</x:String>
                  <x:String>ad-hoc</x:String>
                  <x:String>app-store</x:String>
                  <x:String>enterprise</x:String>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="8,0,0,0">
                <TextBlock Classes="FieldLabel" Text="Signing Style" />
                <ComboBox SelectedItem="{Binding EditProfile.SigningStyle}">
                  <x:String>automatic</x:String>
                  <x:String>manual</x:String>
                </ComboBox>
              </StackPanel>
            </Grid>
            <StackPanel>
              <TextBlock Classes="FieldLabel" Text="Deployment Target" />
              <TextBox Text="{Binding EditProfile.IosDeploymentTarget}" Watermark="13.0" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding IsEditAndroid}">
            <TextBlock Text="Android 签名" FontWeight="Bold" Foreground="#16A34A" />
            <Grid ColumnDefinitions="*,*" Margin="0">
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Classes="FieldLabel" Text="Keystore 路径" />
                <TextBox Text="{Binding EditProfile.AndroidKeystoreName}" Watermark="keystore 路径" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Classes="FieldLabel" Text="Key Alias" />
                <TextBox Text="{Binding EditProfile.AndroidKeyaliasName}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" Margin="0">
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Classes="FieldLabel" Text="Keystore 密码" />
                <TextBox Text="{Binding EditProfile.AndroidKeystorePass}" PasswordChar="*" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Classes="FieldLabel" Text="Key Alias 密码" />
                <TextBox Text="{Binding EditProfile.AndroidKeyaliasPass}" PasswordChar="*" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Classes="primary" Content="💾 保存" Click="Save_Click" />
            <Button Classes="secondary" Content="取消" Click="Cancel_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
