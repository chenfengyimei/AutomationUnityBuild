<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesktopApp.Views.ArtifactsPage">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Margin="24,20,24,0" Spacing="8">
      <TextBlock Classes="page-title" Text="产物浏览" />
      <TextBlock Classes="page-subtitle" Text="查看历史打包产物和日志" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="配置:" VerticalAlignment="Center" FontWeight="Medium" />
        <ComboBox ItemsSource="{Binding Configs}" SelectedItem="{Binding SelectedConfig}" MinWidth="300">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayText}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="secondary" Content="刷新" Click="Refresh_Click" />
      </StackPanel>
      <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" />
    </StackPanel>

    <Border Grid.Row="1" Margin="24,8,24,16" Classes="card" Background="#F8FAFC">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="300" Margin="0,0,16,0">
          <TextBlock Text="历史产物目录" FontWeight="Bold" Margin="0,0,0,8" />
          <ListBox ItemsSource="{Binding RunFolders}" SelectedItem="{Binding SelectedRunFolder}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="📁" />
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                  </StackPanel>
                  <TextBlock Text="{Binding Created}" FontSize="11" Foreground="#64748B" />
                  <TextBlock Text="{Binding DisplaySize}" FontSize="11" Foreground="#2563EB" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <StackPanel DockPanel.Dock="Left" Width="260" Margin="0,0,16,0">
          <TextBlock Text="目录内容" FontWeight="Bold" Margin="0,0,0,8" />
          <ListBox ItemsSource="{Binding CurrentFiles}" SelectedItem="{Binding SelectedFile}" DoubleTapped="FileItem_DoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="4">
                  <TextBlock Text="{Binding Icon}" />
                  <TextBlock Text="{Binding Name}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto">
          <Grid Grid.Column="0">
            <TextBox Classes="log-output" Text="{Binding LogPreview}" AcceptsReturn="True" />
          </Grid>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="8">
            <Button Classes="secondary" Content="打开目录" Click="OpenDir_Click" />
            <Button Classes="secondary" Content="打开文件" Click="OpenFile_Click" IsEnabled="{Binding HasSelectedFile}" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
